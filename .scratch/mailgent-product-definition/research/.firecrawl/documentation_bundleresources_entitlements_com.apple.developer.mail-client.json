{"abstract":[{"text":"A Boolean that indicates whether the app can act as a user’s default email client.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.bundleresources\/documentation\/BundleResources","doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.bundleresources\/documentation\/BundleResources\/Entitlements\/com.apple.developer.mail-client"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"externalID":"entitlements:Entitlements.com.apple.developer.mail-client","modules":[{"name":"Bundle Resources"}],"navigatorTitle":[{"kind":"text","text":"com.apple.developer.mail-client"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"14.0","name":"iOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"14.0","name":"iPadOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"1.0","name":"visionOS","unavailable":false}],"role":"symbol","roleHeading":"Property List Key","symbolKind":"typealias","title":"com.apple.developer.mail-client"},"primaryContentSections":[{"details":{"name":"com.apple.developer.mail-client","platforms":[],"titleStyle":"symbol","value":[{"arrayMode":false,"baseType":"boolean"}]},"kind":"details","title":"Details"},{"content":[{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The system launches the default mail client in iOS whenever a user opens a ","type":"text"},{"code":"mailto:","type":"codeVoice"},{"text":" link. Since email is a critical avenue for communication, Apple requires that email apps must meet specific functional criteria aimed at ensuring private and accurate access for users.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can use this managed entitlement to allow people to use your app as a default mail app. To request this entitlement, sign in to your developer account with the Account Holder role, go to the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/contact\/request\/default-mail-client","isActive":true,"type":"reference"},{"text":" page, and fill out the form on that page.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Any app that registers as a default email client option must:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Specify the ","type":"text"},{"code":"mailto:","type":"codeVoice"},{"text":" scheme in its ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Be able to send a message to any valid email recipient.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Be able to receive a message from any email sender. Apps that provide user-controlled incoming mail screening features are permitted.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/bundleresources\/entitlements\/com.apple.developer.mail-client"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/bundleresources\/entitlements\/com.apple.developer.mail-client"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.apple.bundleresources/documentation/BundleResources":{"abstract":[{"text":"Resources located in an app, framework, or plugin bundle.","type":"text"}],"identifier":"doc:\/\/com.apple.bundleresources\/documentation\/BundleResources","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Bundle Resources"}],"role":"collection","title":"Bundle Resources"